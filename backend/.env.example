OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Hugging Face read token - required, used for scheme-search embeddings.
# Create one free at https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# Voice input (speech-to-text) - optional, only needed to enable the mic button.
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_STT_MODEL=saaras:v3
